MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# Change this to rename the database. Bootstrap creates it if missing.
MYSQL_DATABASE=opportunitypedia

# Change these to rename tables. Used everywhere instead of hardcoded names.
TABLE_USERS=users
TABLE_PAYMENTS=payments
TABLE_PASSWORD_TOKENS=password_setup_tokens
TABLE_RADAR_RUNS=radar_runs
TABLE_RADAR_JOBS=radar_jobs

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin

JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8765,http://localhost:8765

ACCESS_AMOUNT_CENTS=4900
ACCESS_AMOUNT_PAISE=4900
ACCESS_CURRENCY=inr
RADAR_MAX_JOBS_PER_BOARD=500

# Paste your SAM.gov public API key here (Opportunities + Entity).
SAM_GOV_API_KEY=
SAM_LOOKBACK_DAYS=365
# NAICS 5613 Employment Services: placement, exec search, temp help, PEO
SAM_NAICS_CODES=561311,561312,561320,561330
# Sent as ncode, one request per code. Verified: SAM does NOT accept the 5613
# parent (0 results) or a comma-joined list (0 results) — full codes only.
# Non-federal keys get 10 Opportunities requests/day, so 4 codes = ~2 runs/day.
SAM_NAICS_QUERY=561311,561312,561320,561330
SAM_MAX_ROWS_PER_CODE=2000
SAM_EXCLUDE_EXPIRED=true
# Entity API calls for vendor legal names; each one costs a request. 0 = off.
SAM_ENTITY_LOOKUPS=0

# A run spends one SAM request per NAICS code against a 10/day key quota.
RADAR_RUN_COOLDOWN_HOURS=6
RADAR_RUNS_PER_DAY=2
# Local dev only: OP has no sign-in yet, so the read API answers as this
# customer when no bearer token is sent. Keep 0 anywhere off localhost.
OP_PUBLIC_USER_ID=0

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

APP_PUBLIC_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
